# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Instance data: never commit raw telemetry or derived outputs ---
# Raw signal files (real or synthetic) stay local; add them to the
# instance's own data/ dir, never to version control.
instances/*/data/*.csv
instances/*/data/*.parquet
instances/*/data/*.json

# Exception: the cycling real-data file is committed — it is the cleaned
# output of the GoldenCheetah OpenData pipeline (anonymised, open-access).
# Source: https://osf.io/6hfpz/ (DOI 10.17605/OSF.IO/6HFPZ)
!instances/cycling/data/gc_opendata_ride.csv
!instances/cycling/data/real_ride_sample.csv

# Exception: F1 synthetic lap (DECLARED — generated by data/generate_synthetic.py).
# Real Abu Dhabi 2021 telemetry was removed: F1/FOM terms restrict redistribution
# of timing and telemetry data. Real files must be kept out of version control.
!instances/f1/data/synthetic_lap.csv
!instances/f1/data/generate_synthetic.py

# Derived output CSVs produced by run.py (ver_governed.csv etc.)
# Baselines in tests/fixtures/ ARE committed — they are the contract.
instances/*/*.csv

# Generated figures
instances/*/*.png
instances/*/*.pdf
instances/*/*.svg

# --- knowledge/ classification guard ---
# Files without a classification header are blocked by pre_commit_hook.py.
# Unclassified drafts should live outside the repo until they are labeled.
knowledge/*.draft.md

# --- Secrets / credentials ---
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json
credentials.json

# --- Claude Code ---
# Commit .claude/settings.json (project hooks) but not session caches
.claude/todos/
.claude/*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
